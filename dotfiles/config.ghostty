font-family = "FiraCode"
font-size = 24
adjust-cell-width = -3
background-opacity = 0.85
theme = "TokyoNight"
macos-titlebar-style = "tabs"
keybind = global:ctrl+0=toggle_visibility
# treat ctrl+enter as enter
keybind = "ctrl+enter=text:\r"
# treat shift+enter as newline
keybind = shift+enter=text:\x1b\r

